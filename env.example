# Bu dosyayı .env olarak kopyala ve gerçek anahtarını sadece orada yaz.
# .env dosyası .gitignore ile sürüm kontrolünden hariç tutulur.
KEDY_API_KEY=kedy_ornek_anahtar_buraya_gercek_anahtarini_yaz
PORT=3000

# İsteğe bağlı kullanım sınırları (yayında kotanı korur)
# IP başına dakikada en fazla istek sayısı (varsayılan: 6)
RATE_LIMIT_PER_MIN=6
# Tüm kullanıcılar için günlük toplam istek sayısı (varsayılan: 500)
DAILY_LIMIT=500
